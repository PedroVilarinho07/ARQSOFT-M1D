@startuml
participant System

System -> BookController : requestRecommendations(readerNumber, numGenres, numBooks)
BookController -> BookService : getBooksSuggestionsForReader(requestDTO)

BookService -> BookRecommendationY : bookRecommendations(requestDTO)
BookRecommendationY -> GenreRepository : getGenreWithMostLendings(numGenres)

GenreRepository --> BookRecommendationY : return List<Genre>
BookRecommendationY -> BookRepository : findXBooksByGenre(genre, numBooks)
BookRepository --> BookRecommendationY : return List<Book>

BookRecommendationY --> BookService : List<Book>
BookService --> BookController : List<Book>
BookController --> System : Display Recommended Books
@enduml
