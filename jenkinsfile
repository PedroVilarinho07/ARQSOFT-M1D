pipeline {
    agent any

    environment {
        GITHUB_URL = 'https://github.com/PedroVilarinho07/ARQSOFT-M1D.git'
        GITHUB_BRANCH = 'main'
        GITHUB_CREDENTIALS = 'Password_for_Github'

        JENKINS_NODE_COOKIE = "dontKillMe"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "${GITHUB_BRANCH}", 
                    credentialsId: "${GITHUB_CREDENTIALS}", 
                    url: "${GITHUB_URL}"
            }
        }

        stage('Clean') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn clean'
                    } else {
                        bat 'mvn clean'
                    }
                }
            }
        }

        stage('Validate') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn validate'
                    } else {
                        bat 'mvn validate'
                    }
                }
            }
        }

        stage('Compile') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn compile'
                    } else {
                        bat 'mvn compile'
                    }
                }
            }
        }

        stage('Checkstyle') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn checkstyle:checkstyle'
                    } else {
                        bat 'mvn checkstyle:checkstyle'
                    }
                }
            }
        }

        stage('Spotbugs') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn spotbugs:spotbugs'
                    } else {
                        bat 'mvn spotbugs:spotbugs'
                    }
                }
            }
        }

        stage('Generate Javadoc') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn javadoc:javadoc'
                    } else {
                        bat 'mvn javadoc:javadoc'
                    }
                }
            }
        }

        stage('Unit Tests') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn test'
                    } else {
                        bat 'mvn test'
                    }
                }
            }
        }

        stage('Integration Tests') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn failsafe:integration-test'
                    } else {
                        bat 'mvn failsafe:integration-test'
                    }
                }
            }
        }

        stage('Acceptance Tests') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn test -Dtest=**/*AcceptanceTestCase'
                    } else {
                        bat 'mvn test -Dtest=**/*AcceptanceTestCase'
                    }
                }
            }
        }

        stage('Mutation Coverage') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn test-compile org.pitest:pitest-maven:mutationCoverage'
                    } else {
                        bat 'mvn test-compile org.pitest:pitest-maven:mutationCoverage'
                    }
                }
            }
        }

        stage('Surefire Reports') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn surefire-report:report-only'
                        sh 'mvn surefire-report:failsafe-report-only'
                    } else {
                        bat 'mvn surefire-report:report-only'
                        bat 'mvn surefire-report:failsafe-report-only'
                    }
                }
            }
        }

        stage('Jacoco Report') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn jacoco:report'
                    } else {
                        bat 'mvn jacoco:report'
                    }
                }
            }
        }

        stage('Package') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn package -DskipTests'
                    } else {
                        bat 'mvn package -DskipTests'
                    }
                }
            }
        }

        stage('Verify') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn verify -DskipTests'
                    } else {
                        bat 'mvn verify -DskipTests'
                    }
                }
            }
        }

        stage('Install') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn install -DskipTests'
                    } else {
                        bat 'mvn install -DskipTests'
                    }
                }
            }
        }

        stage('Deploy Application') {
            steps {
                script {
                    def jarPath = "${workspace}/target/psoft-g1-0.0.1-SNAPSHOT.jar"
                    def command = "java -jar ${jarPath}"

                    if (isUnix()) {
                        sh "nohup ${command} --server.port=2228 &"
                    } else {
                        bat "start /B ${command} --server.port=8081"
                    }
                }
            }
        }
    }
}
