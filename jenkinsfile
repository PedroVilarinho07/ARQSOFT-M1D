pipeline {
    agent any

    environment {
        GITHUB_URL = 'https://github.com/PedroVilarinho07/ARQSOFT-M1D'
        GITHUB_BRANCH = 'main'
        GITHUB_CREDENTIALS = 'Password_for_Github'

        JENKINS_NODE_COOKIE = "dontKillMe"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "${GITHUB_BRANCH}", 
                    credentialsId: "${GITHUB_CREDENTIALS}", 
                    url: "${GITHUB_URL}"
            }
        }

        stage('Clean') {
            steps {
                script {
                    runCmd('./mvnw clean')
                }
            }
        }

        stage('Validate') {
            steps {
                script {
                    runCmd('./mvnw validate')
                }
            }
        }

        stage('Compile') {
            steps {
                script {
                    runCmd('./mvnw compile')
                }
            }
        }

        stage('Checkstyle') {
            steps {
                script {
                    runCmd('./mvnw checkstyle:checkstyle')
                }
            }
        }

        stage('Spotbugs') {
            steps {
                script {
                    runCmd('./mvnw spotbugs:spotbugs')
                }
            }
        }

        stage('Generate Javadoc') {
            steps {
                script {
                    runCmd('./mvnw javadoc:javadoc')
                }
            }
        }

        stage('Unit Tests') {
            steps {
                script {
                    runCmd('./mvnw test')
                }
            }
        }

        stage('Integration Tests') {
            steps {
                script {
                    runCmd('./mvnw failsafe:integration-test')
                }
            }
        }

        stage('Acceptance Tests') {
            steps {
                script {
                    runCmd('./mvnw test -Dtest=**/*AcceptanceTestCase')
                }
            }
        }

        stage('Mutation Coverage') {
            steps {
                script {
                    runCmd('./mvnw test-compile org.pitest:pitest-maven:mutationCoverage')
                }
            }
        }

        stage('Surefire Reports') {
            steps {
                script {
                    runCmd('./mvnw surefire-report:report-only')
                    runCmd('./mvnw surefire-report:failsafe-report-only')
                }
            }
        }

        stage('Jacoco Report') {
            steps {
                script {
                    runCmd('./mvnw jacoco:report')
                }
            }
        }

        stage('Package') {
            steps {
                script {
                    runCmd('./mvnw package -DskipTests')
                }
            }
        }

        stage('Verify') {
            steps {
                script {
                    runCmd('./mvnw verify -DskipTests')
                }
            }
        }

        stage('Install') {
            steps {
                script {
                    runCmd('./mvnw install -DskipTests')
                }
            }
        }

        stage('Deploy Application') {
            steps {
                script {
                    def jarPath = "${workspace}/target/psoft-g1-0.0.1-SNAPSHOT.jar"
                    def command = "java -jar ${jarPath}"

                    if (isUnix()) {
                        sh "nohup ${command} --server.port=2228 &"
                    } else {
                        bat "start /B ${command} --server.port=8081"
                    }
                }
            }
        }
    }

    def runCmd(cmd) {
        if (isUnix()) {
            sh cmd
        } else {
            bat cmd
        }
    }
}
