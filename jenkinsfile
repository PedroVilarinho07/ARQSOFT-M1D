pipeline {
    agent any

    environment {
        GITHUB_URL = ''
        GITHUB_BRANCH = ''
        GITHUB_CREDENTIALS = ''

        JENKINS_NODE_COOKIE = "dontKillMe"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "${GITHUB_BRANCH}", 
                    credentialsId: "${GITHUB_CREDENTIALS}", 
                    url: "${GITHUB_URL}"
            }
        }

        stage('Clean') {
            steps {
                script {
                    if (isUnix()) {
                        sh './mvnw clean'
                    } else {
                        bat './mvnw clean'
                    }
                }
            }
        }

        stage('Validate') {
            steps {
                script {
                    if (isUnix()) {
                        sh './mvnw validate'
                    } else {
                        bat './mvnw validate'
                    }
                }
            }
        }

        stage('Compile') {
            steps {
                script {
                    if (isUnix()) {
                        sh './mvnw compile'
                    } else {
                        bat './mvnw compile'
                    }
                }
            }
        }

        stage('Checkstyle') {
            steps {
                script {
                    if (isUnix()) {
                        sh './mvnw checkstyle:checkstyle'
                    } else {
                        bat './mvnw checkstyle:checkstyle'
                    }
                }
            }
        }

        stage('Spotbugs') {
            steps {
                script {
                    if (isUnix()) {
                        sh './mvnw spotbugs:spotbugs'
                    } else {
                        bat './mvnw spotbugs:spotbugs'
                    }
                }
            }
        }

        stage('Generate Javadoc') {
            steps {
                script {
                    if (isUnix()) {
                        sh './mvnw javadoc:javadoc'
                    } else {
                        bat './mvnw javadoc:javadoc'
                    }
                }
            }
        }

        stage('Unit Tests') {
            steps {
                script {
                    if (isUnix()) {
                        sh './mvnw test'
                    } else {
                        bat './mvnw test'
                    }
                }
            }
        }

        stage('Integration Tests') {
            steps {
                script {
                    if (isUnix()) {
                        sh './mvnw failsafe:integration-test'
                    } else {
                        bat './mvnw failsafe:integration-test'
                    }
                }
            }
        }

        stage('Acceptance Tests') {
            steps {
                script {
                    if (isUnix()) {
                        sh './mvnw test -Dtest=**/*AcceptanceTestCase'
                    } else {
                        bat './mvnw test -Dtest=**/*AcceptanceTestCase'
                    }
                }
            }
        }

        stage('Mutation Coverage') {
            steps {
                script {
                    if (isUnix()) {
                        sh './mvnw test-compile org.pitest:pitest-maven:mutationCoverage'
                    } else {
                        bat './mvnw test-compile org.pitest:pitest-maven:mutationCoverage'
                    }
                }
            }
        }

        stage('Surefire Reports') {
            steps {
                script {
                    if (isUnix()) {
                        sh './mvnw surefire-report:report-only'
                        sh './mvnw surefire-report:failsafe-report-only'
                    } else {
                        bat './mvnw surefire-report:report-only'
                        bat './mvnw surefire-report:failsafe-report-only'
                    }
                }
            }
        }

        stage('Jacoco Report') {
            steps {
                script {
                    if (isUnix()) {
                        sh './mvnw jacoco:report'
                    } else {
                        bat './mvnw jacoco:report'
                    }
                }
            }
        }

        stage('Package') {
            steps {
                script {
                    if (isUnix()) {
                        sh './mvnw package -DskipTests'
                    } else {
                        bat './mvnw package -DskipTests'
                    }
                }
            }
        }

        stage('Verify') {
            steps {
                script {
                    if (isUnix()) {
                        sh './mvnw verify -DskipTests'
                    } else {
                        bat './mvnw verify -DskipTests'
                    }
                }
            }
        }

        stage('Install') {
            steps {
                script {
                    if (isUnix()) {
                        sh './mvnw install -DskipTests'
                    } else {
                        bat './mvnw install -DskipTests'
                    }
                }
            }
        }

        stage('Deploy Application') {
            steps {
                script {
                    def jarPath = "${workspace}/target/psoft-g1-0.0.1-SNAPSHOT.jar"
                    def command = "java -jar ${jarPath}"

                    if (isUnix()) {
                        sh "nohup ${command} --server.port=2228 &"
                    } else {
                        bat "start /B ${command} --server.port=8081"
                    }
                }
            }
        }
    }
}
